USBtinyISP:
arduino-1.8.19/hardware/tools/avr/bin/avrdude -Carduino-1.8.19/hardware/MightyCore/avr/avrdude.conf -v -patmega1284p -cusbtiny -e -Ulfuse:w:0xF7:m -Uhfuse:w:0xD7:m -Uefuse:w:0xFD:m -Ulock:w:0x3F:m -Uflash:w:firmware.hex:i

